    fontname = "sans-serif"
    "module.keyvault.data.azurerm_client_config.current" [label="data.azurerm_client_config.current"];
    "module.keyvault.azurerm_key_vault.test_key_vault" [label="azurerm_key_vault.test_key_vault"];
  }
  subgraph "cluster_module.networking" {
    label = "module.networking"
    fontname = "sans-serif"
    "module.networking.azurerm_network_security_group.db_test_nsg" [label="azurerm_network_security_group.db_test_nsg"];
    "module.networking.azurerm_network_security_group.web_test_nsg" [label="azurerm_network_security_group.web_test_nsg"];
