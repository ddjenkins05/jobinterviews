digraph G {
  rankdir = "RL";
  node [shape = rect, fontname = "sans-serif"];
  "azurerm_resource_group.main" [label="azurerm_resource_group.main"];
  subgraph "cluster_module.compute" {
    label = "module.compute"
    fontname = "sans-serif"
    "module.compute.azurerm_network_interface.nic" [label="azurerm_network_interface.nic"];
    "module.compute.azurerm_public_ip.web" [label="azurerm_public_ip.web"];
    "module.compute.azurerm_windows_virtual_machine.vm" [label="azurerm_windows_virtual_machine.vm"];
  }
